msgid "Backup File Created"
msgstr "Ficheiro de Backup Criado"

#: Mopy/bash/barb.py:188
msgid "There was an error while trying to back up Wrye Bash's settings!"
msgstr "Ocorreu um erro ao tentar fazer backup das configurações do Wrye Bash!"

#: Mopy/bash/barb.py:190
msgid "No backup was created."
msgstr "Nenhum backup foi criado."

#: Mopy/bash/barb.py:190
msgid "Unable to Create Backup!"
msgstr "Não foi possível Criar o Backup!"

#: Mopy/bash/barb.py:299
msgid "The data format of the selected backup file is newer than the current Wrye Bash version!"
msgstr "O formato de dados do ficheiro de backup selecionado é mais recente que a versão atual do Wrye Bash!"

#: Mopy/bash/barb.py:301
#, python-format
msgid "Backup %(saved_backup_ver)s is not compatible with %(wb_ver)s."
msgstr "O backup %(saved_backup_ver)s não é compatível com %(wb_ver)s."

#: Mopy/bash/barb.py:305
msgid "You cannot use this backup with this version of Wrye Bash."
msgstr "Não pode usar este backup com esta versão do Wrye Bash."

#: Mopy/bash/barb.py:306
msgid "Error: Settings Are From Newer Wrye Bash Version"
msgstr "Erro: As Configurações são de uma Versão Mais Recente do Wrye Bash"

#: Mopy/bash/barb.py:312
#, python-format
msgid "The selected backup file is for %(game_name)s while your current game is %(curr_bak_name)s"
msgstr "O ficheiro de backup selecionado é para %(game_name)s enquanto o seu jogo atual é %(curr_bak_name)s"

#: Mopy/bash/barb.py:314
msgid "Error: Settings Are From a Different Game"
msgstr "Erro: As Configurações são de um Jogo Diferente"

#: Mopy/bash/barb.py:314
msgid "You cannot use this backup with this game."
msgstr "Não pode usar este backup com este jogo."

#: Mopy/bash/barb.py:323
msgid "The version of Wrye Bash used to create the selected backup file does not match the current Wrye Bash version!"
msgstr "A versão do Wrye Bash usada para criar o ficheiro de backup selecionado não corresponde à versão atual do Wrye Bash!"

#: Mopy/bash/barb.py:326
#, python-format
msgid "Backup %(saved_backup_ver)s does not match %(wb_ver)s."
msgstr "O backup %(saved_backup_ver)s não corresponde a %(wb_ver)s."

#: Mopy/bash/barb.py:330
msgid "Do you want to restore this backup anyway?"
msgstr "Deseja restaurar este backup mesmo assim?"

#: Mopy/bash/barb.py:330
msgid "Warning: Version Mismatch"
msgstr "Aviso: Incompatibilidade de Versão"

#: Mopy/bash/barb.py:378
msgid "There was an error while trying to restore your settings from the backup file!"
msgstr "Ocorreu um erro ao tentar restaurar as suas configurações a partir do ficheiro de backup!"

#: Mopy/bash/barb.py:379
msgid "No settings were restored."
msgstr "Nenhuma configuração foi restaurada."

#: Mopy/bash/barb.py:380
msgid "Unable to restore backup!"
msgstr "Não foi possível restaurar o backup!"

#: Mopy/bash/bash.py:231
msgid "This most likely means you are missing a certain version of the Microsoft Visual C++ Redistributable. Try installing the latest x64 version."
msgstr "Isto provavelmente significa que falta uma determinada versão do Microsoft Visual C++ Redistributable. Tente instalar a versão x64 mais recente."

#: Mopy/bash/bash.py:236
msgid "Ensure you have installed these dependencies properly. Should the error still occur, check your installed Microsoft Visual C++ Redistributables and try installing the latest x64 version."
msgstr "Certifique-se de ter instalado estas dependências corretamente. Se o erro persistir, verifique os Microsoft Visual C++ Redistributables instalados e tente instalar a versão x64 mais recente."

#: Mopy/bash/bash.py:241
msgid "The following dependencies could not be located or failed to load:"
msgstr "As seguintes dependências não puderam ser localizadas ou falharam ao carregar:"

#: Mopy/bash/bash.py:252
