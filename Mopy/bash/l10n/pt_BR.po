#: Mopy/bash/barb.py:138
msgid "A different version of Wrye Bash was previously installed."
msgstr "Uma versão diferente do Wrye Bash foi instalada anteriormente."

#: Mopy/bash/barb.py:139
#, python-format
msgid "Previous Version: %(prev_bash_ver)s"
msgstr "Versão Anterior: %(prev_bash_ver)s"

#: Mopy/bash/barb.py:141
#, python-format
msgid "Current Version: %(curr_bash_ver)s"
msgstr "Versão Atual: %(curr_bash_ver)s"

#: Mopy/bash/barb.py:143
msgid "Do you want to create a backup of your Wrye Bash settings before they are overwritten?"
msgstr "Deseja criar um backup das suas configurações do Wrye Bash antes que sejam substituídas?"

#: Mopy/bash/barb.py:144
msgid "Create Backup?"
msgstr "Criar Backup?"

#: Mopy/bash/barb.py:179
msgid "Your Wrye Bash settings have been backed up successfully."
msgstr "O backup das suas configurações do Wrye Bash foi criado com sucesso."

#: Mopy/bash/barb.py:180
#, python-format
msgid "Backup Path: %(backup_dest_file)s"
msgstr "Caminho do Backup: %(backup_dest_file)s"

#: Mopy/bash/barb.py:182
msgid "Backup File Created"
msgstr "Arquivo de Backup Criado"

#: Mopy/bash/barb.py:188
msgid "There was an error while trying to back up Wrye Bash's settings!"
msgstr "Ocorreu um erro ao tentar fazer backup das configurações do Wrye Bash!"

#: Mopy/bash/barb.py:190
msgid "No backup was created."
msgstr "Nenhum backup foi criado."

#: Mopy/bash/barb.py:190
msgid "Unable to Create Backup!"
msgstr "Não foi possível Criar o Backup!"

#: Mopy/bash/barb.py:299
msgid "The data format of the selected backup file is newer than the current Wrye Bash version!"
msgstr "O formato de dados do arquivo de backup selecionado é mais recente que a versão atual do Wrye Bash!"

#: Mopy/bash/barb.py:301
#, python-format
msgid "Backup %(saved_backup_ver)s is not compatible with %(wb_ver)s."
msgstr "O backup %(saved_backup_ver)s não é compatível com %(wb_ver)s."

#: Mopy/bash/barb.py:305
msgid "You cannot use this backup with this version of Wrye Bash."
msgstr "Você não pode usar este backup com esta versão do Wrye Bash."

#: Mopy/bash/barb.py:306
msgid "Error: Settings Are From Newer Wrye Bash Version"
msgstr "Erro: As Configurações são de uma Versão Mais Recente do Wrye Bash"

#: Mopy/bash/barb.py:312
#, python-format
msgid "The selected backup file is for %(game_name)s while your current game is %(curr_bak_name)s"
msgstr "O arquivo de backup selecionado é para %(game_name)s enquanto seu jogo atual é %(curr_bak_name)s"

#: Mopy/bash/barb.py:314
msgid "Error: Settings Are From a Different Game"
msgstr "Erro: As Configurações são de um Jogo Diferente"

#: Mopy/bash/barb.py:314
msgid "You cannot use this backup with this game."
msgstr "Você não pode usar este backup com este jogo."

#: Mopy/bash/barb.py:323
msgid "The version of Wrye Bash used to create the selected backup file does not match the current Wrye Bash version!"
msgstr "A versão do Wrye Bash usada para criar o arquivo de backup selecionado não corresponde à versão atual do Wrye Bash!"

#: Mopy/bash/barb.py:326
#, python-format
msgid "Backup %(saved_backup_ver)s does not match %(wb_ver)s."
msgstr "O backup %(saved_backup_ver)s não corresponde a %(wb_ver)s."

#: Mopy/bash/barb.py:330
msgid "Do you want to restore this backup anyway?"
msgstr "Deseja restaurar este backup mesmo assim?"

#: Mopy/bash/barb.py:330
msgid "Warning: Version Mismatch"
msgstr "Aviso: Incompatibilidade de Versão"

#: Mopy/bash/barb.py:378
msgid "There was an error while trying to restore your settings from the backup file!"
msgstr "Ocorreu um erro ao tentar restaurar suas configurações a partir do arquivo de backup!"

#: Mopy/bash/barb.py:379
msgid "No settings were restored."
msgstr "Nenhuma configuração foi restaurada."

#: Mopy/bash/barb.py:380
msgid "Unable to restore backup!"
msgstr "Não foi possível restaurar o backup!"

#: Mopy/bash/bash.py:235
msgid "This most likely means you are missing a certain version of the Microsoft Visual C++ Redistributable. Try installing the latest x64 version."
msgstr "Isso provavelmente significa que está faltando uma determinada versão do Microsoft Visual C++ Redistributable. Tente instalar a versão x64 mais recente."

#: Mopy/bash/bash.py:239
msgid "Ensure you have installed these dependencies properly. Should the error still occur, check your installed Microsoft Visual C++ Redistributables and try installing the latest x64 version."
msgstr "Certifique-se de ter instalado essas dependências corretamente. Se o erro persistir, verifique os Microsoft Visual C++ Redistributables instalados e tente instalar a versão x64 mais recente."

#: Mopy/bash/bash.py:244
msgid "The following dependencies could not be located or failed to load:"
msgstr "As seguintes dependências não puderam ser localizadas ou falharam ao carregar:"

#: Mopy/bash/bash.py:255
msgid "Installation appears incomplete. Please reinstall Wrye Bash so that all files are installed."
msgstr "A instalação parece incompleta. Reinstale o Wrye Bash para que todos os arquivos sejam instalados."

#: Mopy/bash/bash.py:257
#, python-format
msgid "Correct installation will create a filled %(wb_folder)s folder."
msgstr "A instalação correta criará uma pasta %(wb_folder)s preenchida."

#: Mopy/bash/bash.py:274
msgid "Only one instance of Wrye Bash can run."
msgstr "Apenas uma instância do Wrye Bash pode ser executada."

#: Mopy/bash/bash.py:283
msgid "The locale to set when launching Wrye Bash."
msgstr "A localidade a ser definida ao iniciar o Wrye Bash."

#: Mopy/bash/bash.py:284
msgid "The display name of the last game that was launched through Wrye Bash's 'Select Game' dialog."
msgstr "O nome de exibição do último jogo que foi iniciado através da caixa de diálogo 'Selecionar Jogo' do Wrye Bash."

#: Mopy/bash/bash.py:450
#, python-format
msgid "Generating HTML file from '%(gen_target)s'"
msgstr "Gerando arquivo HTML a partir de '%(gen_target)s'"

#: Mopy/bash/bash.py:454 Mopy/bash/basher/__init__.py:3782
#: Mopy/bash/bosh/bain.py:2047
msgid "Done"
msgstr "Concluído"

#: Mopy/bash/bash.py:486
#, python-format
msgid "Wrye Bash encountered OSError 22. This is often caused by OneDrive backing up the Documents folder. Please follow the directions in the following link under \"Change PC folder backup settings\", removing your Documents folder from backup: %(ms_docs_url)s"
msgstr "O Wrye Bash encontrou o OSError 22. Isso geralmente é causado pelo OneDrive fazendo backup da pasta Documentos. Siga as instruções no link a seguir em \"Alterar configurações de backup de pastas do PC\", removendo sua pasta Documentos do backup: %(ms_docs_url)s"

#: Mopy/bash/bash.py:491
#, python-format
msgid "Should the error persist, please post your BashBugDump to the official thread at %(thread_url)s or to the Wrye Bash Discord at %(discord_url)s"
msgstr "Se o erro persistir, poste seu BashBugDump no tópico oficial em %(thread_url)s ou no Discord do Wrye Bash em %(discord_url)s"

#: Mopy/bash/bash.py:497
#, python-format
msgid "Wrye Bash encountered an error. Please post the information below as well as your BashBugDump to the official thread at %(thread_url)s or to the Wrye Bash Discord at %(discord_url)s"
msgstr "O Wrye Bash encontrou um erro. Poste as informações abaixo, bem como seu BashBugDump, no tópico oficial em %(thread_url)s ou no Discord do Wrye Bash em %(discord_url)s"

#: Mopy/bash/bash.py:576
msgid "Error! Unable to start Wrye Bash."
msgstr "Erro! Não é possível iniciar o Wrye Bash."

#: Mopy/bash/bash.py:576
msgid "Please ensure Wrye Bash is correctly installed."
msgstr "Certifique-se de que o Wrye Bash esteja instalado corretamente."

#: Mopy/bash/bash.py:595
#, python-format
msgid "Wrye Bash needs administrator privileges to make changes to the %(gameName)s directory. If you do not start Wrye Bash with elevated privileges, you will be prompted at each operation that requires elevated privileges."
msgstr "O Wrye Bash precisa de privilégios de administrador para fazer alterações no diretório %(gameName)s. Se você não iniciar o Wrye Bash com privilégios elevados, será solicitado a cada operação que os exija."

#: Mopy/bash/bash.py:619 Mopy/bash/basher/settings_dialog.py:756
msgid "Backup Wrye Bash Settings"
