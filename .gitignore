# binaries
*.pyc
__pycache__/
*.exe
# ...except the bundled 7-Zip
!Mopy/bash/compiled/*.exe

# tmp
*.log
*.patch
*.diff
*.tmp

# the generated default ini
Mopy/bash_default.ini

# the user ini
Mopy/bash.ini

# the shortcuts in the Mopy/App folder
Mopy/Apps/*.lnk

# Windows etc
desktop.ini
Thumbs.db
.dropbox
.DS_Store

# Build-related folders
scripts/build/standalone/dist/
scripts/build/standalone/temp/
scripts/changelogs/
scripts/dist/

# Make sure no one pushes their tokens...
scripts/github.ini

# Local NSIS
scripts/build/nsis/

# Local redistributables
Mopy/redist/

# translation files
Mopy/bash/l10n/*.mo
Mopy/bash/l10n/*NEW.po

# IDE files - no trailing slash, so they also match if they are symlinks
.idea
.vscode

# Common virtual environments - anchored to the repo root, else env/ would
# also match our Mopy/bash/env package (and ENV/ too, on case-insensitive
# Windows filesystems), silently ignoring any new file added there
/.env
/.venv
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/

# pytest-cov
.coverage
.cov_html/

# Minimal LOOT masterlists - stored locally & updated manually
Mopy/taglists/
scripts/taginfo.txt
